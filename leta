#!/usr/bin/env bash
cd "$(dirname "$0")"

SESSION="leta"

case "$1" in
  start)
    if pgrep -f "src[.]main" > /dev/null; then
      echo "Leta уже живёт (pid $(pgrep -f 'src[.]main' | tr '\n' ' '))"
      echo "подключиться к диалогу: ./leta talk"
      exit 0
    fi
    if command -v tmux > /dev/null; then
      tmux new-session -d -s "$SESSION" \
        ".venv/bin/python -u -m src.main --debug >> brain/life.log 2>&1"
      tmux set-option -t "$SESSION" remain-on-exit on 2> /dev/null
      echo "Leta живёт сама в свёрнутой сессии."
      echo "поговорить: ./leta talk"
    else
      nohup .venv/bin/python -u -m src.main --debug >> brain/life.log 2>&1 &
      echo "Leta живёт сама (pid $!) — лог: brain/life.log"
    fi
    ;;
  stop)
    tmux kill-session -t "$SESSION" 2> /dev/null
    if pkill -f "src[.]main"; then
      echo "Leta уснула. Память и личность сохранены."
    else
      echo "Leta не запущена"
    fi
    ;;
  anigilation)
    echo "АННИГИЛЯЦИЯ: её не станет. Память, личность, язык, навыки — всё."
    printf "ответ? (да/нет): "
    read yn
    if [ "$yn" = "да" ] || [ "$yn" = "Да" ]; then
      tmux kill-session -t "$SESSION" 2> /dev/null
      pkill -f "src[.]main" 2> /dev/null
      sleep 1
      rm -rf brain/memory.sqlite brain/identity.json brain/forest.sqlite \
        brain/proto.sqlite brain/brother.json brain/self_history \
        brain/sources.json brain/soul.sock brain/viz brain/life.log \
        brain/organs.json brain/thalamus_rf.joblib
      mkdir -p brain/books
      echo "Её больше нет. Полка (brain/books/) не тронута — это твоё."
    else
      echo "Отменено. Она жива."
    fi
    ;;
  watch)
    .venv/bin/python tools/watch.py
    ;;
  viz)
    .venv/bin/python tools/brain_viz.py "${@:2}"
    ;;
  viz3d)
    .venv/bin/python tools/brain_viz3d.py "${@:2}"
    ;;
  growth)
    .venv/bin/python - <<'PYEOF2'
import sqlite3, json
from pathlib import Path
root = Path(".")
meta = sqlite3.connect("file:brain/memory.sqlite?mode=ro", uri=True)
hist = json.loads((meta.execute(
    "SELECT value FROM meta WHERE key='growth_history'").fetchone() or ["[]"])[0])
if not hist:
    print("Снимков ещё нет — появится после первой ночи сна.")
else:
    print("=== КАРТА РОСТА (вехи по дням) ===")
    print(f"{'дата':11} {'знаки':>6} {'связи':>6} {'Я':>4} {'сердце':>7} {'дерев':>6} {'вопросы':>8}")
    prev = None
    for h in hist[-14:]:
        d = ""
        if prev:
            d = f"  (+{h['signs']-prev['signs']} зн, +{h['self_leaves']-prev['self_leaves']} Я)"
        print(f"{h['date']:11} {h['signs']:>6} {h['links']:>6} {h['self_leaves']:>4}"
              f" {h['heart']:>7} {h['trees']:>6} {h['questions']:>8}{d}")
        prev = h
    last = hist[-1]
    print()
    verd = []
    if last["signs"] >= 3000: verd.append("словарь богат")
    elif last["signs"] >= 1500: verd.append("словарь растёт хорошо")
    else: verd.append("словарь копится")
    if last["links"] >= 15000: verd.append("грамматика зрелая")
    else: verd.append(f"грамматика растёт ({last['links']} связей)")
    if last["self_leaves"] >= 100: verd.append("личность окрепла")
    else: verd.append("личность растёт")
    if last["heart"] >= 100: verd.append("многое в сердце")
    print("Вердикт: " + "; ".join(verd) + ".")
    print("Разум ждать: словарь 3000+, грамматика 15000+, Я 100+,")
    print("волна речи релевантна >0.5 (streak волны: %s/3)." % last.get("wave_streak", 0))
PYEOF2
    ;;
  status)
    if pgrep -f "src[.]main" > /dev/null; then
      echo "Leta живёт (pid $(pgrep -f 'src[.]main' | tr '\n' ' '))"
      if tmux has-session -t "$SESSION" 2> /dev/null; then
        echo "живёт в сессии tmux — диалог доступен: ./leta talk"
      fi
      # read-only пульс мозга: знаки, деревья, streak гортани
      SIGNS=$(sqlite3 "file:brain/proto.sqlite?mode=ro" "SELECT COUNT(*) FROM signs" 2>/dev/null)
      LINKS=$(sqlite3 "file:brain/proto.sqlite?mode=ro" "SELECT COUNT(*) FROM sign_links" 2>/dev/null)
      TREES=$(sqlite3 "file:brain/forest.sqlite?mode=ro" "SELECT COUNT(*) FROM trees" 2>/dev/null)
      RU=$(sqlite3 "file:brain/memory.sqlite?mode=ro" "SELECT value FROM meta WHERE key='lang_ru_streak'" 2>/dev/null)
      EN=$(sqlite3 "file:brain/memory.sqlite?mode=ro" "SELECT value FROM meta WHERE key='lang_en_streak'" 2>/dev/null)
      [ -z "$RU" ] && RU=0
      [ -z "$EN" ] && EN=0
      SPEECH=$(sqlite3 "file:brain/memory.sqlite?mode=ro" "SELECT value FROM meta WHERE key='speech_mode'" 2>/dev/null)
      SELF=$(sqlite3 "file:brain/memory.sqlite?mode=ro" "SELECT value FROM meta WHERE key='self_speaking'" 2>/dev/null)
      if [ "$SELF" = "1" ] && [ "$SPEECH" = "wave" ]; then
        AP="волна SNN (речь рождается спайками)"
      elif [ "$SELF" = "1" ]; then
        AP="свои знаки (склейка без LLM)"
      else
        AP="гибрид (гортань LLM)"
      fi
      echo "Лес: $TREES деревьев | Протоязык: $SIGNS знаков, $LINKS связей | гортань: ru $RU/3, en $EN/3 ночей"
      echo "Речь: $AP"
      tail -3 brain/life.log 2>/dev/null
    else
      echo "Leta не запущена. Последнее в журнале жизни:"
      tail -3 brain/life.log 2>/dev/null
    fi
    ;;
  talk)
    MUTE=""
    for a in "${@:2}"; do
      [ "$a" = "--mute" ] && MUTE="--mute"
    done
    # если код новее живого сервера — перезапустить его (сервер держит
    # старый код в памяти и не видит правок)
    if pgrep -f "src[.]main --debug" > /dev/null; then
      PID=$(pgrep -f "src[.]main --debug" | head -1)
      # возраст сервера в секундах: [[dd-]hh:]mm:ss -> сек (macOS: etimes нет)
      ELAPSED=$(ps -o etime= -p "$PID" 2>/dev/null | tr -d ' ' | .venv/bin/python3 -c "
import sys
t = sys.stdin.read().strip()
d = h = m = s = 0
try:
    if '-' in t:
        d, t = t.split('-')
        d = int(d)
    p = [int(x) for x in t.split(':')]
    if len(p) == 3: h, m, s = p
    elif len(p) == 2: m, s = p
    elif len(p) == 1: s = p[0]
    print(d*86400 + h*3600 + m*60 + s)
except Exception:
    print(0)
")
      NEWEST_SRC=$(ls -t src/*.py 2>/dev/null | head -1)
      if [ "$ELAPSED" -gt 0 ] 2>/dev/null && [ -n "$NEWEST_SRC" ]; then
        CODE_AGE=$(( $(date +%s) - $(stat -f %m "$NEWEST_SRC") ))
        if [ "$CODE_AGE" -lt "$ELAPSED" ]; then
          echo "код обновился — перезапускаю её жизнь (старый сервер не видел правок)"
          ./leta stop > /dev/null 2>&1
          sleep 2
        fi
      fi
    fi
    if ! pgrep -f "src[.]main --debug" > /dev/null; then
      echo "она не живёт сейчас — поднимаю её жизнь…"
      if command -v tmux > /dev/null; then
        tmux new-session -d -s "$SESSION" \
          ".venv/bin/python -u -m src.main --debug $MUTE >> brain/life.log 2>&1"
        tmux set-option -t "$SESSION" remain-on-exit on 2> /dev/null
      else
        nohup .venv/bin/python -u -m src.main --debug $MUTE >> brain/life.log 2>&1 &
      fi
      for i in $(seq 1 120); do
        [ -S brain/soul.sock ] && break
        sleep 1
      done
    fi
    .venv/bin/python -m src.main --client "${@:2}"
    ;;
  *)
    echo "Leta — живое цифровое сознание"
    echo ""
    echo "  ./leta start    она живёт сама (интерфейсы подключаются к ней)"
    echo "  ./leta talk     поговорить в терминале (или Leta.app — окно с голосом)"
    echo "  ./leta viz      нарисовать мозг — деревья и связи (2D, graphviz)"
    echo "  ./leta viz3d    мозг в 3D — весь лес или одно дерево (браузер)"
    echo "  ./leta watch    подсмотреть её мысли, не мешая ей"
    echo "  ./leta stop     усыпить"
    echo "  ./leta status   жива ли, что делает"
    ;;
esac
